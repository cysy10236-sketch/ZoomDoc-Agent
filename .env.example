# ==============================================================================
# ZoomDoc-Agent 环境变量配置模板 (.env)
# ==============================================================================
# 所有配置变量以 ZOOMDOC_ 为前缀（在代码中由 pydantic-settings 自动解析）

# ------------------------------------------------------------------------------
# 选项 1：阿里云百炼 (DashScope) Qwen-VL 系列（推荐：qwen2.5-vl-72b-instruct 或 qwen2.5-vl-7b-instruct）
# ------------------------------------------------------------------------------
# 百炼兼容 OpenAI 协议接口地址：
ZOOMDOC_VLM_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
ZOOMDOC_VLM_API_KEY="sk-your-aliyun-dashscope-api-key"
# 必须使用固定版本快照或官方确切模型名，例如：qwen2.5-vl-72b-instruct 或 qwen-vl-max
ZOOMDOC_VLM_MODEL="qwen2.5-vl-72b-instruct"
# 注意：通义千问 Qwen-VL 原生输出为 0-1000 归一化或绝对像素。默认我们使用 xyxy_1000 规范模式：
ZOOMDOC_BBOX_FORMAT="xyxy_1000"

# ------------------------------------------------------------------------------
# 选项 2：Moonshot AI (Kimi) 系列 (支持 Vision 的模型，如 moonshot-v1-8k-vision-preview)
# ------------------------------------------------------------------------------
# ZOOMDOC_VLM_BASE_URL="https://api.moonshot.cn/v1"
# ZOOMDOC_VLM_API_KEY="sk-your-moonshot-api-key"
# ZOOMDOC_VLM_MODEL="moonshot-v1-8k-vision-preview"
# ZOOMDOC_BBOX_FORMAT="xyxy_1000"

# ------------------------------------------------------------------------------
# 通用推理与视觉超参数配置
# ------------------------------------------------------------------------------
ZOOMDOC_VLM_SEED=42
ZOOMDOC_VLM_MAX_TOKENS=1024
ZOOMDOC_VLM_TIMEOUT_S=120.0
ZOOMDOC_IMAGE_ENCODING="png"
ZOOMDOC_JPEG_QUALITY=90

# 视觉渲染分辨率分级配置
ZOOMDOC_SOURCE_DPI=200
ZOOMDOC_VIEW_LONG_SIDE=1024
ZOOMDOC_THUMB_LONG_SIDE=448
ZOOMDOC_GRID_LINE_WIDTH=40

# 局部放大 (Zoom) 参数
ZOOMDOC_ZOOM_PAD_RATIO=0.10
ZOOMDOC_ZOOM_MIN_NORM_SIDE=0.05
ZOOMDOC_ZOOM_TARGET_LONG_SIDE=1024
ZOOMDOC_ZOOM_MAX_UPSCALE=4.0

# 业务防死循环预算上限
ZOOMDOC_MAX_PAGES=20
ZOOMDOC_MAX_STEPS=8
ZOOMDOC_MAX_ZOOMS=3
ZOOMDOC_MAX_INSPECTOR_IMAGES=6
ZOOMDOC_MAX_ATTEMPTS=3

ZOOMDOC_RUNS_DIR="runs"
